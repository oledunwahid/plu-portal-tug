generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl", "linux-musl-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role values: CASHIER | ADMIN
// requestType values: NEW_ITEM | UPDATE_PRICE | UPDATE_NAME | UPDATE_PRINTER | UPDATE_FULL | REMOVE_PLU
// status values: PENDING | DONE
// Note: UPDATE_FULL kept for backward compatibility with existing records; REMOVE_PLU added for item removal requests

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  name             String
  role             String            @default("CASHIER")
  outlet           String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  requests         PLURequest[]
  batches          RequestBatch[]
  discountRequests DiscountRequest[]
}

model RequestBatch {
  id            String             @id @default(cuid())
  title         String
  requestType   String
  status        String             @default("PENDING")
  outletGroup   String
  cashierOutlet String
  userId        String
  submittedBy   User               @relation(fields: [userId], references: [id])
  items         RequestBatchItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  doneAt        DateTime?
  adminNote     String?
  exportedAt    DateTime?
  exportBatchId String?
}

model RequestBatchItem {
  id                   String       @id @default(cuid())
  batchId              String
  batch                RequestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  code                 String?
  codeIsAutoGenerated  Boolean      @default(true)
  name                 String
  category      String
  department    String
  price         Float?
  folder        String?
  serviceCharge Boolean      @default(true)
  tax1          Boolean      @default(true)
  tax2          Boolean      @default(true)
  noDiscount    Boolean      @default(true)
  hideReceipt   Boolean      @default(false)
  printers      String
  outlets       String
  salesDef      String       @default("SALES")
  barcode       String?
  remarks       String?
  sortOrder     Int          @default(0)
}

model MasterItem {
  id            String   @id @default(cuid())
  active        Int      @default(1)
  code          String   @unique
  name          String
  category      String
  department    String
  salesDef      String   @default("SALES")
  price         Float?
  plu           String?
  barcode       String?
  uom           String?
  folder        String?
  serviceCharge Int      @default(1)
  tax1          Int      @default(1)
  tax2          Int      @default(1)
  noDiscount    Int      @default(1)
  hideReceipt   Int      @default(0)
  printers      String?
  outlets       String?
  outletGroup   String?
  importedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WikiArticle {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String
  isPinned    Boolean  @default(false)
  createdBy   String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlossaryEntry {
  id                String   @id @default(cuid())
  type              String
  term              String
  definition        String
  defaultDefinition String?
  grp               String?
  isSeeded          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DiscountRequest {
  id                String                @id @default(cuid())
  status            String                @default("PENDING")
  outletGroup       String
  cashierOutlet     String
  userId            String
  user              User                  @relation(fields: [userId], references: [id])

  buttonName        String
  discountType      String
  discountValue     Float
  discountValueType String
  outlets           String                @default("")
  applicableTo      String
  conditions        String?
  remarks           String?

  adminNote         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  doneAt            DateTime?
}

model OutletConfig {
  id        String   @id @default(cuid())
  code      String   @unique
  group     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrinterConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  group     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoryConfig {
  id             String   @id @default(cuid())
  name           String   @unique
  department     String
  departmentCode Int
  categoryCode   Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PLURequest {
  id            String   @id @default(cuid())
  requestType   String
  status        String   @default("PENDING")

  code                 String?
  codeIsAutoGenerated  Boolean  @default(true)
  name                 String
  category             String
  department           String
  price                Float?
  folder               String?
  serviceCharge        Boolean  @default(true)
  tax1                 Boolean  @default(true)
  tax2                 Boolean  @default(true)
  noDiscount           Boolean  @default(true)
  hideReceipt          Boolean  @default(false)
  printers             String
  outlets              String
  salesDef             String   @default("SALES")
  barcode              String?
  remarks              String?

  submittedBy   User     @relation(fields: [userId], references: [id])
  userId        String
  outletGroup   String
  cashierOutlet String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  doneAt        DateTime?
  adminNote     String?
  exportedAt    DateTime?
  exportBatchId String?
}
