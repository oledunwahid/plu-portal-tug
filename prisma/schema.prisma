generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "linux-musl", "linux-musl-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role values: CASHIER | ADMIN
// requestType values: NEW_ITEM | UPDATE_PRICE | UPDATE_NAME | UPDATE_PRINTER | UPDATE_FULL | REMOVE_PLU
// status values: PENDING | DONE
// Note: UPDATE_FULL kept for backward compatibility with existing records; REMOVE_PLU added for item removal requests

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  name             String
  role             String            @default("CASHIER")
  outlet           String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())

  // Wine List module - additive business identity, deliberately NOT a new `role` value so every
  // existing CASHIER code path keeps working unchanged. accountType = "WINE_PIC" marks the Wine Cork
  // account (branding + Wine List access); businessUnit is its brand label ("Wine Cork").
  // winePermissions is an optional explicit grant list ("ALL" or semicolon-separated permission
  // names) letting an admin open Wine List to a non-WINE_PIC user for maintenance.
  accountType      String?
  businessUnit     String?
  winePermissions  String?

  requests         PLURequest[]
  batches          RequestBatch[]
  discountRequests DiscountRequest[]
}

model RequestBatch {
  id            String             @id @default(cuid())
  title         String
  requestType   String
  status        String             @default("PENDING")
  outletGroup   String
  cashierOutlet String
  userId        String
  submittedBy   User               @relation(fields: [userId], references: [id])
  items         RequestBatchItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  updatedBy     String?
  exportCount    Int      @default(0)
  lastExportedAt DateTime?
  lastExportedBy String?
  doneAt        DateTime?
  adminNote     String?
  exportedAt    DateTime?
  exportBatchId String?
}

model RequestBatchItem {
  id                   String       @id @default(cuid())
  batchId              String
  batch                RequestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  code                 String?
  codeIsAutoGenerated  Boolean      @default(true)
  name                 String
  category      String
  department    String
  price         Float?
  folder        String?
  serviceCharge Boolean      @default(true)
  tax1          Boolean      @default(true)
  tax2          Boolean      @default(true)
  noDiscount    Boolean      @default(true)
  hideReceipt   Boolean      @default(false)
  printers      String
  outlets       String
  salesDef      String       @default("SALES")
  barcode       String?
  remarks       String?
  sortOrder     Int          @default(0)
}

model MasterItem {
  id            String   @id @default(cuid())
  active        Int      @default(1)
  code          String   @unique
  name          String
  category      String
  department    String
  salesDef      String   @default("SALES")
  price         Float?
  plu           String?
  barcode       String?
  uom           String?
  folder        String?
  serviceCharge Int      @default(1)
  tax1          Int      @default(1)
  tax2          Int      @default(1)
  noDiscount    Int      @default(1)
  hideReceipt   Int      @default(0)
  printers      String?
  outlets       String?
  outletGroup   String?
  importedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WikiArticle {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String
  isPinned    Boolean  @default(false)
  createdBy   String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GlossaryEntry {
  id                String   @id @default(cuid())
  type              String
  term              String
  definition        String
  defaultDefinition String?
  grp               String?
  isSeeded          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DiscountRequest {
  id                String                @id @default(cuid())
  status            String                @default("PENDING")
  outletGroup       String
  cashierOutlet     String
  userId            String
  user              User                  @relation(fields: [userId], references: [id])

  buttonName        String
  discountType      String
  discountValue     Float
  discountValueType String
  outlets           String                @default("")
  applicableTo      String
  conditions        String?
  remarks           String?

  adminNote         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  updatedBy         String?
  doneAt            DateTime?
}

model OutletConfig {
  id        String   @id @default(cuid())
  code      String   @unique
  group     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrinterConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  group     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoryConfig {
  id             String   @id @default(cuid())
  name           String   @unique
  department     String
  departmentCode Int
  categoryCode   Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PLURequest {
  id            String   @id @default(cuid())
  requestType   String
  status        String   @default("PENDING")

  code                 String?
  codeIsAutoGenerated  Boolean  @default(true)
  name                 String
  category             String
  department           String
  price                Float?
  folder               String?
  serviceCharge        Boolean  @default(true)
  tax1                 Boolean  @default(true)
  tax2                 Boolean  @default(true)
  noDiscount           Boolean  @default(true)
  hideReceipt          Boolean  @default(false)
  printers             String
  outlets              String
  salesDef             String   @default("SALES")
  barcode              String?
  remarks              String?

  // Cost Control approval stage (WINE NEW_ITEM from Cork outlets). suggestedBarcode is the
  // system-derived SAP NCK barcode, suggestedBarcodeSource its human-readable origin label, and
  // confirmedBarcode the value cost control commits. No unique constraint: legacy rows may hold
  // duplicate bad barcodes (e.g. old +11 arithmetic results) that would break a unique migration.
  suggestedBarcode        String?
  suggestedBarcodeSource  String?
  confirmedBarcode        String?

  submittedBy   User     @relation(fields: [userId], references: [id])
  userId        String
  outletGroup   String
  cashierOutlet String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     String?
  exportCount    Int      @default(0)
  lastExportedAt DateTime?
  lastExportedBy String?
  doneAt        DateTime?
  adminNote     String?
  exportedAt    DateTime?
  exportBatchId String?

  // Wine List publication stamps. A DONE wine request may become a Wine Master exactly once;
  // WineMaster.sourceRequestId is the hard uniqueness guarantee, these are the request-side marks
  // that make the "Publish to Wine List" button disappear.
  publishedToWineList Boolean   @default(false)
  publishedAt         DateTime?
  publishedBy         String?
}

// ── Wine List module ─────────────────────────────────────────────────────────
// Source-of-truth split: everything POS-owned (PLU code, barcode, price, folder, outlets, UOM,
// tax/service flags, active-per-outlet) stays on MasterItem and is read through masterItemId.
// WineMaster owns only wine attributes. masterItemCode/masterItemName are a search/sort cache.

model WineMaster {
  id                 String   @id @default(cuid())
  masterItemId       String
  masterItemCode     String?
  masterItemName     String?
  sourceRequestId    String?  @unique
  legacyWineCode     String?
  importBatchId      String?

  wineName           String
  normalizedName     String   @default("")
  displayName        String?
  producerId         String?
  countryId          String?
  regionId           String?
  appellationId      String?
  classificationId   String?
  wineTypeId         String?
  categoryId         String?
  subCategory1Id     String?
  subCategory2Id     String?
  bottleSizeId       String?
  vintage            Int?
  isNonVintage       Boolean  @default(false)
  abv                Float?
  description        String?
  tastingNotes       String?
  foodPairing        String?
  servingTemperature String?
  internalNotes      String?
  costPerBottle      Float?
  status             String   @default("Active")

  createdAt          DateTime @default(now())
  createdBy          String?
  updatedAt          DateTime @updatedAt
  updatedBy          String?

  varietals          WineVarietal[]

  @@index([normalizedName])
  @@index([masterItemId])
  @@index([importBatchId])
}

model WineVarietal {
  id           String     @id @default(cuid())
  wineMasterId String
  wine         WineMaster @relation(fields: [wineMasterId], references: [id], onDelete: Cascade)
  varietalId   String
  percentage   Float?

  @@index([wineMasterId])
}

// Append-only. Nothing in the UI updates or deletes rows here.
model WineAuditLog {
  id           String   @id @default(cuid())
  wineMasterId String
  action       String
  fieldName    String?
  oldValue     String?
  newValue     String?
  performedBy  String?
  performedAt  DateTime @default(now())

  @@index([wineMasterId])
}

model WineImportBatch {
  id            String    @id @default(cuid())
  fileName      String
  totalRows     Int       @default(0)
  createdRows   Int       @default(0)
  updatedRows   Int       @default(0)
  duplicateRows Int       @default(0)
  failedRows    Int       @default(0)
  skippedRows   Int       @default(0)
  matchedRows   Int       @default(0)
  unmatchedRows Int       @default(0)
  status        String    @default("COMPLETED")
  uploadedBy    String?
  uploadedAt    DateTime  @default(now())
  completedAt   DateTime?
  rolledBackAt  DateTime?
  rolledBackBy  String?
}

model WineImportError {
  id             String   @id @default(cuid())
  importBatchId  String
  rowNumber      Int
  wineName       String?
  pluCode        String?
  barcode        String?
  error          String
  recommendation String?
  createdAt      DateTime @default(now())

  @@index([importBatchId])
}

// One generic reference table for all wine lists (PRODUCER, COUNTRY, REGION, APPELLATION, VARIETAL,
// WINE_TYPE, CATEGORY, SUB_CATEGORY, BOTTLE_SIZE, CLASSIFICATION). normalizedName is unique per type,
// which is what rejects "Bouchard Père & Fils" vs "BOUCHARD PERE & FILS" as the same producer.
model WineMasterData {
  id             String   @id @default(cuid())
  type           String
  code           String?
  name           String
  normalizedName String
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  createdBy      String?
  updatedAt      DateTime @updatedAt
  updatedBy      String?

  @@unique([type, normalizedName])
}
